{
  "name": "pi-harmony",
  "version": "1.6.1",
  "description": "A cohesive Pi workspace with polished interaction, tools, skills, and question workflows",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tool-renderer",
    "mcp",
    "terminal-images",
    "tool-groups",
    "math-rendering",
    "latex",
    "keybindings",
    "shiki",
    "diff",
    "terminal-theme",
    "ghostty",
    "subagents",
    "spinner",
    "skills",
    "agent-tools",
    "tui",
    "theme",
    "vague"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Triangulation5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Triangulation5/pi-harmony.git"
  },
  "homepage": "https://github.com/Triangulation5/pi-harmony#readme",
  "bugs": {
    "url": "https://github.com/Triangulation5/pi-harmony/issues"
  },
  "files": [
    "extensions/index.ts",
    "extensions/commands/**",
    "extensions/bash/**",
    "extensions/session/**",
    "extensions/settings/**",
    "extensions/terminal/**",
    "extensions/markdown/**",
    "extensions/shared/**",
    "skills/web-search-cli/SKILL.md",
    "skills/web-search-cli/scripts/search.py",
    "skills/web-search-cli/scripts/run-search.mjs",
    "themes/vague.json",
    "packages/rpiv-ask-user-question/**",
    "packages/rpiv-todo/**",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts tests/**/*.test.mts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/index.ts extensions/terminal/animations/spinner.ts extensions/session/continue.ts packages/rpiv-ask-user-question/src/index.ts packages/rpiv-todo/index.ts",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run"
  },
  "dependencies": {
    "@juicesharp/rpiv-config": "^2.15.0",
    "@shikijs/cli": "^4.0.2",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@juicesharp/rpiv-i18n": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@juicesharp/rpiv-i18n": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./extensions/terminal/animations/spinner.ts",
      "./extensions/session/continue.ts",
      "./packages/rpiv-ask-user-question/src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@juicesharp/rpiv-i18n": "^2.15.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.7.0",
    "typebox": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
