{
  "name": "pi-harmony",
  "version": "1.5.2",
  "description": "A cohesive Pi workspace with polished interaction, tools, skills, and question workflows",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tool-renderer",
    "mcp",
    "terminal-images",
    "tool-groups",
    "math-rendering",
    "latex",
    "keybindings",
    "shiki",
    "diff",
    "terminal-theme",
    "ghostty",
    "subagents",
    "spinner",
    "skills",
    "agent-tools",
    "tui",
    "theme",
    "vague"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Triangulation5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Triangulation5/pi-harmony.git"
  },
  "homepage": "https://github.com/Triangulation5/pi-harmony#readme",
  "bugs": {
    "url": "https://github.com/Triangulation5/pi-harmony/issues"
  },
  "files": [
    "extensions/index.ts",
    "extensions/spinner.ts",
    "extensions/continue.ts",
    "extensions/spinner-animation.ts",
    "extensions/spin-dots.ts",
    "extensions/typewriter.ts",
    "extensions/shimmer-text.ts",
    "extensions/settings-path.ts",
    "extensions/settings-store.ts",
    "extensions/bash-command.ts",
    "extensions/bash-file-edit.ts",
    "extensions/bash-intent.ts",
    "extensions/theme-colors.ts",
    "extensions/terminal-theme.ts",
    "extensions/startup-animation.ts",
    "skills/web-search-cli/SKILL.md",
    "skills/web-search-cli/scripts/search.py",
    "skills/web-search-cli/scripts/run-search.mjs",
    "themes/vague.json",
    "packages/rpiv-ask-user-question/**",
    "config/config.example.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test scripts/*.test.ts scripts/*.test.mts",
    "test:fullscreen": "node scripts/fullscreen-mouse.test.mjs",
    "test:fullscreen-copy": "node scripts/fullscreen-copy.test.mjs",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck extensions/index.ts extensions/spinner.ts extensions/continue.ts packages/rpiv-ask-user-question/index.ts",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run",
    "bench:tools": "bun scripts/benchmark-tools.ts"
  },
  "dependencies": {
    "@juicesharp/rpiv-config": "^2.15.0",
    "@shikijs/cli": "^4.0.2",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@juicesharp/rpiv-i18n": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@juicesharp/rpiv-i18n": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./extensions/spinner.ts",
      "./extensions/continue.ts",
      "./packages/rpiv-ask-user-question/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@juicesharp/rpiv-i18n": "^2.15.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.7.0",
    "typebox": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
